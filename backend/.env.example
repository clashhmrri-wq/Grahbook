# Server Setup
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# PostgreSQL Database (replace with your local postgres URI or Supabase/RDS URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/grahakbook?schema=public"

# Razorpay credentials (for customer payment & shopkeeper SaaS subscriptions)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=yyyyyyyyyyyyyyyyy

# WhatsApp Cloud API (for order & delivery notifications)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ONDC Network Gateway credentials (for network publishing)
ONDC_SUBSCRIBER_ID=grahakbook.com
ONDC_UNIQUE_KEY_ID=grahakbook-key-1
ONDC_SIGNING_PRIVATE_KEY=your_ondc_signing_private_key
ONDC_GATEWAY_URL=https://staging.gateway.ondc.org

# Geolocation API (Google Maps or OpenStreetMap/Radar for Address lookup)
GEOCODING_API_KEY=your_geocoding_api_key
