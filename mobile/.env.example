# GrahakBook Mobile App Environment Variables

# The public URL of the backend API (without trailing slash).
# For local Android emulator, use: http://10.0.2.2:5000
# For local iOS simulator or physical device, use your local machine's IP: http://192.168.x.x:5000
# For production/online backend, use the hosted URL: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
